{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Domestic_v1",
  "version": "0.1.0",
  "identifier": "com.matve.domestic-v1",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Domestic_v1",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
